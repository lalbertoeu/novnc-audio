[Unit]
Description=noVNC Audio Server (WebSocket on :8088)
After=pulseaudio.service

[Service]
Type=simple
ExecStart=__INSTALL_DIR__/audio_server/novnc-audio-start.sh
Restart=always
RestartSec=3
Environment=HOME=__USER_HOME__
Environment=XDG_RUNTIME_DIR=/run/user/__USER_UID__

[Install]
WantedBy=default.target